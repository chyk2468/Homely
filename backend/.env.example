# Backend Environment Configuration
PROJECT_NAME="Society Maintenance Complaint Tracker"
SECRET_KEY="replace_with_a_secure_random_jwt_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for dev, or postgresql://user:pass@host:5432/dbname for prod)
DATABASE_URL="sqlite:///./complaint.db"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Email Integration (Resend - Free Tier 3000 emails/month)
RESEND_API_KEY=""
FROM_EMAIL="onboarding@resend.dev"
EMAIL_ENABLED=true

# Default Overdue Threshold (Days)
DEFAULT_OVERDUE_DAYS=7

# Frontend URL
FRONTEND_URL="http://localhost:5173"
